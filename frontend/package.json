{
  "name": "pokedex-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "layers": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "test": "vitest run --coverage",
    "size": "size-limit",
    "api:types": "openapi-typescript ../specs/api/openapi.yaml --output src/api/schema.gen.ts --export-type",
    "api:types:check": "openapi-typescript ../specs/api/openapi.yaml --output src/api/schema.gen.ts --export-type --check",
    "fixtures": "node scripts/record-fixtures.ts && prettier --write src/test/recorded",
    "ui:gen": "bddgen",
    "ui": "bddgen && playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "nuqs": "^2.10.1",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^8.0.6",
    "@eslint-react/eslint-plugin": "^5.21.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@react-aria/optimize-locales-plugin": "^2.0.2",
    "@rolldown/plugin-babel": "^0.2.4",
    "@size-limit/file": "^14.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "knip": "^6.38.0",
    "msw": "^3.0.0",
    "openapi-typescript": "^7.13.0",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "size-limit": "^14.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
