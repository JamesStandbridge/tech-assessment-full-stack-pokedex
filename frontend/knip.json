{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": ["src/**/*.{ts,tsx,css}", "scripts/**/*.ts", "e2e/**/*.ts"],
  "ignore": ["src/api/schema.gen.ts"],
  "entry": ["scripts/*.ts", "e2e/steps/*.ts"],
  "ignoreIssues": {
    "src/api/contract.ts": ["types"],
    "src/api/ports.ts": ["types"],
    "e2e/fixtures.ts": ["exports"]
  }
}
