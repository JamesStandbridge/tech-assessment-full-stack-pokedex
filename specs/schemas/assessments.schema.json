{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assessments.schema.json",
  "title": "Blind assessor grades of pooled candidates",
  "type": "object",
  "required": ["schema_version", "instructions", "grades", "queries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "instructions": { "type": "string", "minLength": 1 },
    "grades": {
      "type": "object",
      "required": ["0", "1", "2", "3"],
      "additionalProperties": false,
      "patternProperties": { "^[0-3]$": { "type": "string" } }
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "query", "candidates"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^Q-[A-Z]+-[0-9]{2}$" },
          "query": { "type": "string", "minLength": 2, "maxLength": 200 },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["ref", "summary", "grade"],
              "additionalProperties": false,
              "properties": {
                "ref": { "type": "string", "pattern": "^(pokemon|move|ability):[a-z0-9]+(-[a-z0-9]+)*$" },
                "summary": { "type": "string", "minLength": 1 },
                "grade": { "type": ["integer", "null"], "minimum": 0, "maximum": 3 }
              }
            }
          }
        }
      }
    }
  }
}
