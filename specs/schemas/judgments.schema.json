{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "judgments.schema.json",
  "title": "Graded relevance judgments",
  "type": "object",
  "required": ["schema_version", "grades", "queries"],
  "additionalProperties": false,
  "$defs": {
    "gradedNames": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 3 }
    }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "grades": {
      "type": "object",
      "required": ["1", "2", "3"],
      "additionalProperties": false,
      "patternProperties": { "^[1-3]$": { "type": "string" } }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "need", "query", "grading_rule", "judgments"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^Q-[A-Z]+-[0-9]{2}$" },
          "need": { "type": "string" },
          "query": { "type": "string", "minLength": 2, "maxLength": 200 },
          "grading_rule": { "type": "string", "minLength": 1 },
          "judgments": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "pokemon": { "$ref": "#/$defs/gradedNames" },
              "move": { "$ref": "#/$defs/gradedNames" },
              "ability": { "$ref": "#/$defs/gradedNames" }
            }
          }
        }
      }
    }
  }
}
